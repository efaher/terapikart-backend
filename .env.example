PORT=3001
ALLOWED_ORIGINS=https://personitacard.netlify.app,https://kart.efia.net.tr
FRONTEND_URL=https://personitacard.netlify.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/personacard
DATABASE_SSL=true
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_LICENSE_SECRET=replace-with-a-second-long-random-secret
REQUIRE_EMAIL_VERIFICATION=false
# Mail provider: auto, resend or smtp. Render Free staging should use resend.
MAIL_PROVIDER=auto
RESEND_API_KEY=
MAIL_FROM=
# Optional SMTP fallback for environments where outbound SMTP is allowed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Legacy alias still accepted by the application.
SMTP_PASS=
# Optional: omitted when AUTH_SECRET should also derive the offline signing key.
OFFLINE_ENTITLEMENT_SECRET=
OFFLINE_ENTITLEMENT_TTL_SECONDS=2592000
ROOM_MAX_AGE_MS=21600000
ROOM_IDLE_CLEANUP_MS=1800000
ROOM_CLEANUP_INTERVAL_MS=900000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=8
ACCOUNT_ACTION_RATE_LIMIT_MAX=5
ADMIN_RATE_LIMIT_MAX=10
